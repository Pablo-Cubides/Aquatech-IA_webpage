# Example environment variables for apps/api
DATABASE_URL="postgres://USER:PASSWORD@HOST:PORT/db?sslmode=require&pgbouncer=true&connection_limit=1"
SHADOW_DATABASE_URL="postgres://USER:PASSWORD@HOST:PORT/shadow_db"

# Firebase
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# Brevo
BREVO_API_KEY=""
BREVO_SENDER_NAME=""
BREVO_SENDER_EMAIL=""
# Token Bearer del webhook /api/email/webhook (SEC-004). Sin él, la ruta responde 401 a todo.
BREVO_WEBHOOK_SECRET=""

# Sentry
SENTRY_DSN=""
SENTRY_ENV="development"

# Upstash Redis (for rate limiting)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

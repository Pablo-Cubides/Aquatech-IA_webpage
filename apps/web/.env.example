# Example environment variables for apps/web
# ⚠️ NUNCA pongas secretos (private keys, API keys de servidor) en variables NEXT_PUBLIC_*
#    — se exponen al navegador. Los secretos van sin prefijo y solo se leen server-side.

# URLs base (usadas en metadata, sitemap, robots)
NEXT_PUBLIC_BASE_URL="https://aquatechia.com"
NEXT_PUBLIC_SITE_URL="https://aquatechia.com"

# Database (server-side only — acceso via @ia-next/database)
DATABASE_URL=""
DIRECT_URL=""

# Google OAuth (server-side, NextAuth)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Supabase (anon key es pública por diseño)
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# APIs de datos ambientales (server-side)
OPENAQ_API_KEY=""
HUGGINGFACE_API_KEY=""

# Mapas (tokens públicos restringidos por dominio)
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=""
NEXT_PUBLIC_FIRMS_MAP_KEY=""

# SEO
NEXT_PUBLIC_GOOGLE_VERIFICATION=""

# Rate limiting (server-side)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Sentry (DSN es público por diseño)
NEXT_PUBLIC_SENTRY_DSN=""
NEXT_PUBLIC_SENTRY_ENV=""

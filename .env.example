# Root environment variables (example)
# Copy this to .env and fill in your values

# Database (PostgreSQL - Supabase or Vercel Postgres)
DATABASE_URL="postgresql://user:password@localhost:5432/ia-next?schema=public"

# Database TLS (SEC-001): el certificado del servidor se VERIFICA por defecto.
# Supabase firma con "Supabase Root 2021 CA", que Node no trae: descarga el certificado
# raiz en Project Settings > Database > SSL configuration y pegalo aqui (PEM, PEM con \n
# o base64 de una linea). Definir en los proyectos de Vercel web y api.
DATABASE_SSL_CA=""
# SOLO emergencia temporal y con fecha de retirada: desactiva la verificacion en el pool
# de Postgres (advertencia en cada arranque). Dejar vacio en produccion.
DATABASE_SSL_ALLOW_UNVERIFIED=""

# NextAuth
NEXTAUTH_SECRET="your-nextauth-secret-here"
NEXTAUTH_URL="http://localhost:3000"

# Google Auth (OAuth)
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# Admin / agente de blog (SEC-001): sin valor por defecto. Si faltan, esas rutas responden
# 500 a proposito. Usar valores largos y aleatorios, distintos en cada entorno.
# Los literales anteriores estuvieron en el repositorio publico: hay que ROTARLOS.
ADMIN_PASSWORD=""
BLOG_AGENT_API_KEY=""

# Brevo Email Service
BREVO_API_KEY="your-brevo-api-key"

# Sentry (Error Tracking)
SENTRY_DSN="your-sentry-dsn"
SENTRY_AUTH_TOKEN="your-sentry-auth-token"
# OPS-001: DSN publico del navegador. Sin el, Sentry no se envuelve y el build queda igual.
NEXT_PUBLIC_SENTRY_DSN=""
# OPS-001: protege el detalle de /api/health. Sin el, un anonimo solo ve {status,timestamp}.
HEALTH_CHECK_TOKEN=""

# Upstash Redis (Rate Limiting)
UPSTASH_REDIS_REST_URL="your-upstash-redis-url"
UPSTASH_REDIS_REST_TOKEN="your-upstash-redis-token"

# App URLs (for webhooks and redirects)
# Base URL for SEO Canonical & Sitemaps (Set to https://aquatechia.com in production)
NEXT_PUBLIC_BASE_URL="https://aquatechia.com"
NEXT_PUBLIC_WEB_URL="https://aquatechia.com"
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Database direct connection (Prisma migrations)
DIRECT_URL="postgresql://user:password@localhost:5432/ia-next?schema=public"

# Webhook de Brevo (SEC-004): Brevo no firma sus webhooks. La ruta exige
# "Authorization: Bearer <BREVO_WEBHOOK_SECRET>"; el webhook se registra en Brevo con
# auth {type:"bearer", token:<mismo valor>}. Sin esta variable la ruta responde 401 a todo.
BREVO_WEBHOOK_SECRET="your-brevo-webhook-secret"

# Environmental data APIs
OPENAQ_API_KEY="your-openaq-api-key"

# Node Environment
NODE_ENV="development"

# Hugging Face API (for trending models tool)
HUGGINGFACE_API_KEY="your-huggingface-api-key"

# SPEC-212: Colega grade synchronization (server only)
GRADE_SYNC_SECRET=
GRADE_RATE_LIMIT_BACKEND=postgres
TRUST_PROXY_HEADERS=true

# ARQ-004: valvula de emergencia. Si la base de datos esta caida durante el build de
# produccion, la generacion de sitemap / llms.txt / llms-full.txt FALLA a proposito, para
# no publicar un indice con la mitad del contenido. Poner a "1" solo para desbloquear un
# despliegue urgente, sabiendo que esos tres archivos saldran incompletos. Dejar vacio.
ALLOW_INCOMPLETE_CONTENT=""

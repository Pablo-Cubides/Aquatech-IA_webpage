{
  "name": "ia-next-monorepo",
  "private": true,
  "version": "0.0.1",
  "description": "IA-first Next.js monorepo with Turborepo, Supabase, Firebase, and modern tooling",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "turbo run format --parallel",
    "typecheck": "turbo typecheck",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:ui": "turbo run test:ui",
    "clean": "turbo clean && rm -rf node_modules",
    "postinstall": "turbo run postinstall --parallel",
    "prepare": "lefthook install",
    "spec:new": "node .specify/scripts/new-feature.mjs",
    "content:new": "node .specify/scripts/new-content.mjs",
    "img:optimize": "node .specify/scripts/optimize-image.mjs",
    "img:budget": "node .specify/scripts/image-budget.mjs",
    "lint:content": "node .specify/scripts/lint-content.mjs",
    "lint:specs": "node .specify/scripts/lint-specs.mjs",
    "sync:contracts": "node .specify/scripts/sync-contracts.mjs",
    "test:sdd-governance": "node .specify/scripts/lint-specs.mjs && node .specify/scripts/lint-content.mjs",
    "release:preflight": "node .specify/scripts/release-preflight.mjs"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/ui": "^4.1.12",
    "eslint": "^8.57.1",
    "gray-matter": "^4.0.3",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "lefthook": "^2.2.2",
    "next": "16.4.3",
    "potrace-wasm": "^1.0.4",
    "prettier": "^3.9.10",
    "sharp": "^0.35.5",
    "stylelint": "^16.26.1",
    "stylelint-config-standard": "^39.0.1",
    "tracer": "^1.3.0",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3",
    "vite": "8.3.5",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=20.19.0",
    "pnpm": ">=8.0.0"
  },
  "packageManager": "pnpm@8.15.6",
  "pnpm": {
    "overrides": {
      "react": "19.3.1",
      "react-dom": "19.3.1",
      "glob@>=10.2.0 <10.5.0": "10.5.0",
      "uuid@>=9 <10": "11.1.1",
      "@opentelemetry/api": "1.9.0"
    }
  },
  "dependencies": {
    "@sentry/nextjs": "^10.76.2",
    "@supabase/supabase-js": "^2.118.0",
    "maplibre-gl": "^6.16.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  }
}
